#!/bin/bash
# hq-status <working|waiting|done|gone> — claude code hook helper. records
# per-pane agent state so the hq board can show glyphs; wire it up with the
# snippet from `hq hooks`. always exits 0 — a hook must never block a tool.
set -u

d="${XDG_RUNTIME_DIR:-/tmp}/hq/state"
p="${TMUX_PANE:-}"
ev="${1:-}"
in=$(cat 2>/dev/null || true)
[ -n "$p" ] || exit 0
mkdir -p "$d" 2>/dev/null || exit 0
find "$d" -type f -mmin +1440 -delete 2>/dev/null

case "$ev" in
  gone) rm -f "$d/$p"; exit 0 ;;
  working|waiting) ;;
  done)
    # Stop with live background tasks is still working
    printf '%s' "$in" | grep -qE '"background_tasks":[[:space:]]*\[[^]]' && ev=working ;;
  *) exit 0 ;;
esac

printf '%s %s\n' "$ev" "$(date -u +%FT%TZ)" > "$d/$p" 2>/dev/null

# a robot stuck on a prompt is a stalled unattended run — surface it
if [ "$ev" = waiting ] && command -v notify-send >/dev/null 2>&1; then
  w=$(tmux display -p -t "$p" '#{window_name}' 2>/dev/null || true)
  case "$w" in
    *-[0-9][0-9][0-9][0-9][0-9][0-9]) notify-send -u critical "hq robot waiting" "$w needs input" ;;
  esac
fi
exit 0
