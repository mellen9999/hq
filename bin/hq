#!/bin/bash
# hq — one status-line segment telling you which claude code session is
# blocked waiting on you, and how close any of them is to its context limit.
# that's it. everything else about running several claudes, tmux already
# does better.
#
#   hq bar      the status-line segment (put it in status-left)
#   hq hooks    print the claude code hooks that power the states
#   hq kill     drop the robot session (see hq-poll)
#
# robots — headless claude workers on a timer — live in their own detached
# session so they never touch your window list. see hq-poll.
set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hq"
# shellcheck source=/dev/null
[ -f "$CONF/hqrc" ] && . "$CONF/hqrc"
: "${HQ_CTX:=200000}" "${HQ_BAR_TTL:=60}"
S="${HQ_SESSION:-hq}"
X="${S}x"                                   # robot container (never attached)
RUN="${XDG_RUNTIME_DIR:-/tmp}/hq"
STATED="$RUN/state"
SELF=$(realpath "$0")

# Which ttys have a live claude on them → g_ttys, plus g_ps as proof the
# process table was actually readable.
#
# Neither of the obvious tells survives: a claude behind `claude; exec bash`
# reports pane_current_command=bash, and the pane title's spinner glyph is not
# a stable contract — claude code moved from braille to ◐◑◒◓ and every tab with
# a working claude silently lost its colour, because bar() read those panes as
# "not claude" and repainted them clean within one status interval. One `ps`
# pass costs about as much as the glyph guess and cannot drift.
claude_ttys() {
  local t c
  g_ttys=(); g_ps=''
  while read -r t c; do
    g_ps=1
    [ "$c" = claude ] && [ "$t" != '?' ] && g_ttys["/dev/$t"]=1
  done < <(ps -eo tty=,comm= 2>/dev/null)
}

ctx_max() {  # $1 model → g_cm context window; HQ_CTX covers unknown models
  case $1 in
    *haiku*)                          g_cm=200000 ;;
    *fable*|*mythos*|*opus*|*sonnet*) g_cm=1000000 ;;
    *)                                g_cm=$HQ_CTX ;;
  esac
}

# one awk pass per transcript gets the context total. ctx = input +
# cache_creation + cache_read of the last main-chain usage block — NOT every
# *_tokens field: output_tokens and the nested cache_creation.ephemeral_*
# object would double-count. the [{,] boundary stops input_tokens from
# matching inside cache_*_input_tokens. sidechain (subagent) turns are
# skipped — their tiny context would lie about the session.
# shellcheck disable=SC2016  # single quotes are the point: awk source, not shell
AWK_PROBE='
function tok(s, k) { return match(s, "[{,]\"" k "\":[0-9]+") ? substr(s, RSTART + length(k) + 4, RLENGTH - length(k) - 4) + 0 : 0 }
{
  if (match($0, /"model":"claude-[^"]*"/)) m = substr($0, RSTART + 9, RLENGTH - 10)
  if ($0 !~ /"isSidechain":true/ && match($0, /"usage":\{[^}]*/)) {
    u = substr($0, RSTART, RLENGTH)
    c = tok(u, "input_tokens") + tok(u, "cache_creation_input_tokens") + tok(u, "cache_read_input_tokens")
  }
}
END { print (m ? m : "-"), c + 0 }
'

transcript() {  # $1 project cwd, $2 pane title → g_tf (newest matching jsonl).
  # several sessions can share a project dir; the title slug appears in
  # exactly one transcript, so this stays per-pane accurate.
  local d slug f=''
  local -a t
  d=${1//\//-}; d=${d//./-}
  d="$HOME/.claude/projects/$d"
  slug=${2#* }
  if [ -n "$slug" ] && [ "$slug" != "Claude Code" ]; then
    # shellcheck disable=SC2012  # mtime order is the point; names are safe
    mapfile -t t < <(ls -t "$d"/*.jsonl 2>/dev/null | head -12)
    (( ${#t[@]} )) && f=$(grep -lF -- "$slug" "${t[@]}" 2>/dev/null | head -1)
  fi
  # shellcheck disable=SC2012
  [ -n "$f" ] || f=$(ls -t "$d"/*.jsonl 2>/dev/null | head -1)
  g_tf=$f
}

pane_state() {  # $1 pane id → g_state (working|waiting|done|'')
  local f="$STATED/$1" st _
  g_state=''
  [ -r "$f" ] || return 0
  read -r st _ < "$f" 2>/dev/null || return 0
  case $st in working|waiting|done) g_state=$st ;; esac
  return 0
}

hooks() {
  # absolute path: hook commands run with the spawning claude's PATH, which
  # for robot panes is the tmux server's — ~/.local/bin may not be on it
  local hs c
  hs="$(dirname "$SELF")/hq-status"
  # Plain: the colour is a per-window window-status-style set by hq-status, not
  # a conditional on @hqstate — user options expand to empty while the status
  # line renders, so a format that reads them paints nothing (tmux 3.7).
  c='#I:#W#{?window_flags,#{window_flags}, }'
  # SessionStart paints a brand-new tab yellow — it is waiting on you before you
  # have typed anything. No matcher: `"matcher": "startup|resume|clear"` never
  # fires (claude code does not treat it as an alternation), so the one source
  # that must NOT repaint — a compaction mid-turn — is filtered from the payload.
  cat <<EOF
1. merge into ~/.claude/settings.json:

{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "jq -e '.source != \\"compact\\"' >/dev/null 2>&1 && $hs waiting </dev/null; true" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "$hs working" }] }],
    "PreToolUse":       [{ "matcher": "*", "hooks": [{ "type": "command", "command": "$hs working" }] }],
    "Notification":     [{ "hooks": [{ "type": "command", "command": "$hs waiting" }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "$hs done" }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "$hs gone" }] }]
  }
}

2. colour the tabs from it, in ~/.tmux.conf:

set -g window-status-format "$c"
set -g window-status-current-format "$c"
set -g status-right "#($(dirname "$SELF")/hq bar)"
EOF
}

# the tabs carry each session's state (the hooks paint them); the only thing
# left that no single tab can tell you is that someone is about to run out of
# context, so that is all this prints — and nothing at all when everyone is
# comfortable. it doubles as the janitor for tabs whose claude died without
# firing SessionEnd.
bar() {
  local sess wid pid tty path title state m c g_state g_tf g_cm g_ps
  local maxpct=0 want
  local now=$EPOCHSECONDS cache="$RUN/bar" cts=0 pane pct
  local -A CPCT=() WANT=() CUR=() g_ttys=()
  # No process table means no idea what is alive — leave every tab exactly as
  # it is rather than reconciling them all to "not claude".
  claude_ttys
  [ -n "$g_ps" ] || return 0
  [ -r "$cache" ] && { read -r cts; while read -r pane pct; do CPCT[$pane]=$pct; done; } < "$cache"
  local fresh=1
  (( now - cts > HQ_BAR_TTL )) && fresh=''
  while IFS='|' read -r sess wid pid tty path title state; do
    [ -n "${CUR[$wid]+x}" ] || CUR[$wid]=$state
    [ "$sess" = "$X" ] && continue          # robots aren't tabs of yours
    [ -n "${g_ttys[$tty]+x}" ] || continue
    pane_state "$pid"
    # `done` belongs here too: a claude that has finished its turn is yellow,
    # and leaving it out made bar() strip that yellow within one status
    # interval — the state you most want to see was the one that never stuck.
    case $g_state in waiting|working|done) WANT[$wid]=$g_state ;; *) WANT[$wid]='' ;; esac
    if [ -n "$fresh" ]; then
      pct=${CPCT[$pid]:-0}
    else
      pct=0
      transcript "$path" "$title"
      if [ -n "$g_tf" ]; then
        read -r m c < <(tail -c 20000 "$g_tf" | awk "$AWK_PROBE")
        ctx_max "$m"
        pct=$(( ${c:-0} * 100 / g_cm )); (( pct > 99 )) && pct=99
      fi
      CPCT[$pid]=$pct
    fi
    (( pct > maxpct )) && maxpct=$pct
  done < <(tmux list-panes -a -F '#{session_name}|#{window_id}|#{pane_id}|#{pane_tty}|#{pane_current_path}|#{pane_title}|#{@hqstate}' 2>/dev/null)
  if [ -z "$fresh" ]; then
    mkdir -p "$RUN" 2>/dev/null
    { echo "$now"; for pane in "${!CPCT[@]}"; do echo "$pane ${CPCT[$pane]}"; done; } > "$cache" 2>/dev/null
  fi
  # only touch tmux when a tab is actually wrong: a crashed claude leaves its
  # colour behind, and a hook can be missed
  for wid in "${!CUR[@]}"; do
    want=${WANT[$wid]:-}
    [ "$want" = "${CUR[$wid]}" ] && continue
    "$(dirname "$SELF")/hq-status" paint "$wid" "${want:-none}"
  done
  # tmux reads job output line-wise — a missing newline means it never appears
  (( maxpct >= 80 )) && printf '#[fg=red]%s%%#[default] \n' "$maxpct"
  return 0
}

case "${1:-}" in
  bar)   bar ;;
  hooks) hooks ;;
  kill)  tmux kill-session -t "=$X" 2>/dev/null
         echo 'hq: robot session gone; your claudes are untouched' ;;
  *) echo 'usage: hq [bar|hooks|kill]' >&2; exit 2 ;;
esac
